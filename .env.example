# Postgres connection string (Neon, Vercel Postgres, Supabase, etc.)
# Example Neon:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/techno_keys?sslmode=require"

# Required by Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="generate-a-long-random-secret"

# Your production site URL (no trailing slash)
AUTH_URL="https://techno-keys.vercel.app"
NEXTAUTH_URL="https://techno-keys.vercel.app"

# Owner login (seeded on deploy/build)
OWNER_EMAIL="admin@technokeys.com"
OWNER_PASSWORD="change-me"
